{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@types/*": ["test/*"]
    },
    "types": ["node", "jest"],
    "noEmit": true,
    "declaration": false
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/__tests__/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.js",
    "coverage"
  ]
}
