# Application Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration (comma-separated domains)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Configuration (RS256 - Asymmetric Encryption)
JWT_EXPIRES_IN=1h

# RSA Private/Public Key Paths (auto-generated if not set)
RSA_PRIVATE_KEY_PATH=./keys/private.key
RSA_PUBLIC_KEY_PATH=./keys/public.key

# Or provide base64-encoded keys directly
# RSA_PRIVATE_KEY=<base64-encoded-private-key>
# RSA_PUBLIC_KEY=<base64-encoded-public-key>

# Device Fingerprinting
FINGERPRINT_SALT=your-custom-salt-key-min-32-characters-here-for-security

# Virus Scanning (ClamAV)
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Upload Configuration
UPLOAD_MAX_FILE_SIZE=52428800 # 50MB in bytes

# Database Configuration
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_NAME=backend_admin

# Logging
LOG_LEVEL=info
